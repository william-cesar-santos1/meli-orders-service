    {
      "id": 5,
      "title": "SLA — Todos endpoints: % requisições abaixo de 300ms",
      "description": "Threshold de aceite da Black Friday: ≥ 95% das requisições em < 300ms",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_bucket{job=\"meli-orders\",instance=~\"$instance\",uri=\"/orders\",method=\"POST\",le=\"0.3\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"meli-orders\",instance=~\"$instance\",uri=\"/orders\",method=\"POST\"}[5m]))",
          "legendFormat": "POST /orders",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_bucket{job=\"meli-orders\",instance=~\"$instance\",uri=\"/orders\",method=\"GET\",le=\"0.3\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"meli-orders\",instance=~\"$instance\",uri=\"/orders\",method=\"GET\"}[5m]))",
          "legendFormat": "GET /orders",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_bucket{job=\"meli-orders\",instance=~\"$instance\",uri=\"/orders/search\",le=\"0.3\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"meli-orders\",instance=~\"$instance\",uri=\"/orders/search\"}[5m]))",
          "legendFormat": "GET /orders/search",
          "refId": "C"
        }
      ],
      "datasource": "Prometheus"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Replica",
        "description": "Filtra por replica da aplicacao. 'All' exibe todas as replicas agregadas.",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up{job=\"meli-orders\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "hide": 0
      }
    ]
  }
